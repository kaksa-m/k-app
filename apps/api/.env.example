# Copy this file to .env and fill in real values before running the API.

# Postgres connection string
DATABASE_URL="postgresql://kaksam:kaksam@localhost:5432/kaksam?schema=public"

# Long random string used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

PORT=4000

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"
