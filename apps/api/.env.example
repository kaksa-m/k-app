# Copy this file to .env for local development.
# In production (Render), set these as real environment variables in the
# dashboard instead — see render.yaml and DEPLOYMENT.md.

# --- Supabase Postgres connection string ---
# Find this in Supabase: Project Settings → Database → Connection string.
# Two variants are offered:
#   - "Direct connection" (port 5432) — fine for a single persistent
#     server like Render, which is what we're using.
#   - "Transaction pooler" / Supavisor (port 6543, add ?pgbouncer=true) —
#     use this instead if you ever run the API as multiple instances or
#     serverless functions, since Postgres has a hard connection limit.
# Supabase requires SSL — keep ?sslmode=require on the end either way.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"

# Long random string used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

PORT=4000

# Comma-separated list of origins allowed to call the API.
# Add your Vercel admin app's URL here once it's deployed
# (e.g. "https://kaksam-admin.vercel.app"), plus localhost for dev.
CORS_ORIGINS="http://localhost:3000"
