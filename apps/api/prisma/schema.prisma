// KAKSAM — Prisma schema
// Multi-tenancy strategy: shared schema, row-level isolation via `schoolId`
// on every tenant-scoped table. See README.md for the reasoning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Auth
// ---------------------------------------------------------------------------

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String?
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  classes       Class[]
  sections      Section[]
  subjects      Subject[]
  students      Student[]
  teachers      Teacher[]
  parents       Parent[]
  announcements Announcement[]
  feeStructures FeeStructure[]
  invoices      Invoice[]

  @@map("schools")
}

enum Role {
  SUPER_ADMIN // Kaksam staff — cross-school
  SCHOOL_ADMIN // Principal / office admin — full school access
  TEACHER
  PARENT
  STUDENT
  ACCOUNTANT
}

// One login identity per person. Role-specific detail lives in
// Teacher / Parent / Student, linked back via userId.
model User {
  id           String   @id @default(cuid())
  schoolId     String?  // null only for SUPER_ADMIN
  email        String   @unique
  passwordHash String
  role         Role
  // Display name for roles without a dedicated profile table
  // (SCHOOL_ADMIN, SUPER_ADMIN, ACCOUNTANT). Teacher/Parent/Student
  // keep their own firstName/lastName on their profile row.
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Teacher?
  parent  Parent?
  student Student?

  @@index([schoolId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String   // e.g. "2026-27"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]
  exams    Exam[]

  @@index([schoolId])
  @@map("academic_years")
}

model Class {
  id       String @id @default(cuid())
  schoolId String
  name     String // e.g. "Class 7"
  order    Int    // for sorting: 1, 2, 3 ... 12

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections Section[]

  @@index([schoolId])
  @@unique([schoolId, name])
  @@map("classes")
}

// A Section is a specific class instance for an academic year —
// e.g. Class 7 / Section A / AY 2026-27 — and is the anchor most
// other records (students, timetable, attendance) hang off of.
model Section {
  id             String @id @default(cuid())
  schoolId       String
  classId        String
  academicYearId String
  name           String // e.g. "A"
  classTeacherId String? // Teacher homeroom-in-charge

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class        Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher Teacher?      @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students     Student[]
  sessions     ClassSession[]

  @@index([schoolId])
  @@unique([classId, academicYearId, name])
  @@map("sections")
}

model Subject {
  id       String @id @default(cuid())
  schoolId String
  name     String
  code     String?

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions ClassSession[]

  @@index([schoolId])
  @@unique([schoolId, name])
  @@map("subjects")
}

// The "single source of truth" relationship from the product plan:
// Section + Subject + Teacher + a weekly time slot = one ClassSession.
// Attendance, Classwork, and Homework all hang off a ClassSession.
model ClassSession {
  id        String   @id @default(cuid())
  sectionId String
  subjectId String
  teacherId String
  dayOfWeek Int      // 0 = Monday ... 6 = Sunday
  startTime String   // "09:00"
  endTime   String   // "09:45"
  room      String?

  section    Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  classworks Classwork[]
  homeworks  Homework[]

  @@index([sectionId])
  @@index([teacherId])
  @@map("class_sessions")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model Teacher {
  id           String   @id @default(cuid())
  schoolId     String
  userId       String   @unique
  firstName    String
  lastName     String
  phone        String?
  department   String?
  employeeCode String?
  joinedAt     DateTime @default(now())

  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSessions  ClassSession[]
  homeroomOf     Section[]      @relation("ClassTeacher")

  @@index([schoolId])
  @@map("teachers")
}

model Parent {
  id        String @id @default(cuid())
  schoolId  String
  userId    String @unique
  firstName String
  lastName  String
  phone     String?

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([schoolId])
  @@map("parents")
}

model Student {
  id           String    @id @default(cuid())
  schoolId     String
  userId       String?   @unique // students may not have login credentials initially
  sectionId    String?
  parentId     String?
  firstName    String
  lastName     String
  rollNumber   String?
  dateOfBirth  DateTime?
  admittedAt   DateTime  @default(now())
  isActive     Boolean   @default(true)

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  section     Section?     @relation(fields: [sectionId], references: [id])
  parent      Parent?      @relation(fields: [parentId], references: [id])
  attendance  Attendance[]
  invoices    Invoice[]

  @@index([schoolId])
  @@index([sectionId])
  @@map("students")
}

// ---------------------------------------------------------------------------
// Operations: attendance, classwork, homework, announcements
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id             String           @id @default(cuid())
  classSessionId String
  studentId      String
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedAt       DateTime         @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentId, date])
  @@index([studentId, date])
  @@map("attendance")
}

model Classwork {
  id             String   @id @default(cuid())
  classSessionId String
  date           DateTime @db.Date
  summary        String
  createdAt      DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId, date])
  @@map("classwork")
}

model Homework {
  id             String   @id @default(cuid())
  classSessionId String
  assignedDate   DateTime @db.Date
  dueDate        DateTime @db.Date
  title          String
  description    String?
  createdAt      DateTime @default(now())

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId, dueDate])
  @@map("homework")
}

enum AnnouncementAudience {
  SCHOOL_WIDE
  SECTION
  STAFF_ONLY
}

model Announcement {
  id        String               @id @default(cuid())
  schoolId  String
  title     String
  body      String
  audience  AnnouncementAudience @default(SCHOOL_WIDE)
  sectionId String?
  createdAt DateTime             @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// Academics: exams (Phase 2 — modeled now so the schema doesn't need
// reshaping later, per the product plan's database-first recommendation)
// ---------------------------------------------------------------------------

model Exam {
  id             String   @id @default(cuid())
  academicYearId String
  name           String   // e.g. "Term 1"
  startDate      DateTime
  endDate        DateTime

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([academicYearId])
  @@map("exams")
}

// ---------------------------------------------------------------------------
// Finance: fees (Phase 1 — basic fee tracking is in MVP scope per the plan)
// ---------------------------------------------------------------------------

model FeeStructure {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   // e.g. "Tuition — Class 7"
  amount      Decimal  @db.Decimal(10, 2)
  frequency   String   // "monthly" | "quarterly" | "annual" | "one-time"
  createdAt   DateTime @default(now())

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([schoolId])
  @@map("fee_structures")
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  studentId      String
  feeStructureId String
  amountDue      Decimal       @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(10, 2)
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  payments     Payment[]

  @@index([schoolId, status])
  @@index([studentId])
  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(10, 2)
  method    String   // "cash" | "online" | "cheque" | ...
  reference String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payments")
}
