{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true
  },
  // Scoped to src/ only so prisma/seed.ts (compiled separately via
  // ts-node, see package.json's prisma.seed) doesn't get pulled into
  // this compile — including it shifts tsc's inferred rootDir up to
  // apps/api/ and nests output under dist/src/ + dist/prisma/ instead
  // of a flat dist/.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
