# Copy to .env.local for local development.
# In production (Vercel), set NEXT_PUBLIC_API_URL as an Environment Variable
# in the Vercel project settings. It should point to the Render API including
# its /api prefix.
#
# The application also has a fallback for the Render service declared in
# render.yaml (`https://kaksam-api.onrender.com/api`), but setting this
# explicitly in Vercel is recommended.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
